# syntax=docker/dockerfile:1

# ── Stage 1: Build RPM ──────────────────────────────────────────────
FROM fedora:44 AS builder

RUN echo -e "fastestmirror=True\nmax_parallel_downloads=10" >> /etc/dnf/dnf.conf

RUN dnf install -y \
    rpm-build \
    rpmdevtools \
    cmake \
    gcc-c++ \
    ninja-build \
    qt6-qtbase-devel \
    && dnf clean all

# rpmbuild should not run as root
RUN useradd -m builder
USER builder
WORKDIR /home/builder

RUN rpmdev-setuptree

# Copy source tree and build package dynamically using VERSION file
COPY --chown=builder:builder . /tmp/src

RUN VERSION=$(cat /tmp/src/VERSION | tr -d '[:space:]') && \
    mkdir -p /tmp/kseek-${VERSION} && \
    cp -r /tmp/src/. /tmp/kseek-${VERSION}/ && \
    tar -czf /home/builder/rpmbuild/SOURCES/kseek-${VERSION}.tar.gz -C /tmp kseek-${VERSION} && \
    sed "s/@VERSION@/${VERSION}/g" /tmp/src/packaging/kseek.spec.in > /home/builder/rpmbuild/SPECS/kseek.spec && \
    rpmbuild -ba /home/builder/rpmbuild/SPECS/kseek.spec

# ── Stage 2: Export ──────────────────────────────────────────────────
FROM scratch AS export
COPY --from=builder /home/builder/rpmbuild/RPMS/*/*.rpm /
