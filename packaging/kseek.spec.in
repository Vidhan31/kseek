%global debug_package %{nil}

Name:           kseek
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Fuzzy file search KRunner plugin using fd + fzf

License:        MIT
URL:            https://github.com/vidhan31/kseek
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  cmake >= 3.25
BuildRequires:  gcc-c++
BuildRequires:  ninja-build
BuildRequires:  qt6-qtbase-devel >= 6.4

Requires:       (fd-find or fd)
Requires:       fzf

%description
A KDE Plasma 6 KRunner plugin for fast fuzzy file searching.
Feeds paths from fd into fzf over D-Bus without running a heavy
indexing daemon in the background.

%prep
%autosetup

%build
%cmake -G Ninja
%cmake_build

%install
%cmake_install

%files
%license LICENSE
%{_bindir}/kseek
%{_datadir}/krunner/dbusplugins/plasma-runner-kseek.desktop
%{_datadir}/dbus-1/services/org.kde.krunner.kseek.service
%{_datadir}/systemd/user/plasma-runner-kseek.service
%{_prefix}/lib/environment.d/kseek.conf

%changelog
* Thu Sep 03 2026 Vidhan Bhatt <heyitsmedevfr@gmail.com> - @VERSION@-1
- Package build
