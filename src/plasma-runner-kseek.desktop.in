[Desktop Entry]
Name=kseek
Comment=Fuzzy search files and directories using fd and fzf
X-KDE-ServiceTypes=Plasma/Runner
Type=Service
Icon=edit-find
X-KDE-PluginInfo-Author=Community
X-KDE-PluginInfo-Name=kseek
X-KDE-PluginInfo-Version=@PROJECT_VERSION@
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-Website=https://github.com/vidhan31/kseek
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.kde.krunner.kseek
X-Plasma-DBusRunner-Path=/kseek
X-Plasma-Runner-Min-Letter-Count=1
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Syntaxes=f :q:
X-Plasma-Runner-Syntax-Descriptions=Search files and directories via fd + fzf
X-Plasma-Runner-Unique-Results=true
X-Plasma-Runner-Weak-Results=false
